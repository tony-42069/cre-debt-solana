# Server Configuration
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/cre_debt_db?schema=public"

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Smart Contract Program IDs
PROGRAM_ID_PROPERTY_REGISTRY=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS
PROGRAM_ID_LOAN_CORE=H4Rdq9n8KJ9P8n7Fg6PaFpoGXkYsidMpWTK6W2BeZ7FE
PROGRAM_ID_BORROWER_REGISTRY=8g6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnU

# Platform Configuration
PLATFORM_AUTHORITY=YourPlatformAuthorityPublicKeyHere
PLATFORM_TREASURY=YourTreasuryPublicKeyHere
PLATFORM_TOKEN_ACCOUNT=YourPlatformTokenAccountHere

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api-docs
