generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id            String   @id
  action        String
  entityType    String
  entityId      String
  userId        String?
  walletAddress String?
  oldValues     String?
  newValues     String?
  metadata      String?
  blockchainTx  String?
  blockNumber   Int?
  createdAt     DateTime @default(now())
}

model loan_applications {
  id              String     @id
  applicationId   String     @unique
  borrowerId      String
  propertyId      String
  requestedAmount Float
  interestRate    Float
  termMonths      Int
  ltvRatio        Float
  status          String     @default("DRAFT")
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  purpose         String?
  additionalDocs  String?
  notes           String?
  blockchainTx    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  properties      properties @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  users           users      @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  loans           loans?
}

model loans {
  id                 String            @id
  loanId             String            @unique
  applicationId      String            @unique
  borrowerId         String
  principalAmount    Float
  interestRate       Float
  termMonths         Int
  ltvRatio           Float
  status             String            @default("PENDING")
  fundedAt           DateTime?
  maturityDate       DateTime
  nextPaymentDue     DateTime?
  totalPaid          Float             @default(0)
  remainingBalance   Float
  originationFee     Float             @default(0)
  daysPastDue        Int               @default(0)
  lastPaymentDate    DateTime?
  defaultedAt        DateTime?
  foreclosureStarted DateTime?
  smartContractId    String?
  blockchainTx       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  users              users             @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  loan_applications  loan_applications @relation(fields: [applicationId], references: [id])
  payments           payments[]
}

model payments {
  id               String    @id
  paymentId        String    @unique
  loanId           String
  amount           Float
  paymentType      String    @default("PRINCIPAL")
  paymentMethod    String    @default("USDC_TRANSFER")
  principalPortion Float     @default(0)
  interestPortion  Float     @default(0)
  feePortion       Float     @default(0)
  status           String    @default("PENDING")
  processedAt      DateTime?
  confirmedAt      DateTime?
  dueDate          DateTime
  paidDate         DateTime?
  isLate           Boolean   @default(false)
  lateFee          Float     @default(0)
  blockchainTx     String?
  blockNumber      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  loans            loans     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model platform_config {
  id                  String   @id
  authorityWallet     String   @unique
  treasuryWallet      String   @unique
  tokenAccount        String   @unique
  maxLtvRatio         Float    @default(0.9)
  minLoanAmount       Float    @default(100000)
  maxLoanAmount       Float    @default(10000000)
  originationFee      Float    @default(0.01)
  servicingFee        Float    @default(0.002)
  minInterestRate     Float    @default(0.05)
  maxInterestRate     Float    @default(0.15)
  defaultInterestRate Float    @default(0.08)
  gracePeriodDays     Int      @default(30)
  lateFeeRate         Float    @default(0.05)
  defaultThreshold    Int      @default(90)
  isActive            Boolean  @default(true)
  maintenanceMode     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
}

model properties {
  id                String              @id
  propertyId        String              @unique
  ownerId           String
  propertyType      String              @default("OFFICE")
  address           String
  city              String
  state             String
  zipCode           String
  country           String              @default("US")
  appraisedValue    Float
  ltvRatio          Float?
  valuationDate     DateTime
  valuationMethod   String              @default("APPRAISAL")
  valuationProvider String
  valuationReport   String?
  status            String              @default("DRAFT")
  verified          Boolean             @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  blockchainTx      String?
  smartContractId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  loan_applications loan_applications[]
  users             users               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model users {
  id                String              @id
  walletAddress     String              @unique
  email             String?             @unique
  entityType        String              @default("INDIVIDUAL")
  kycStatus         String              @default("PENDING")
  kycVerifiedAt     DateTime?
  kycProvider       String?
  riskScore         Int?                @default(500)
  totalBorrowed     Float               @default(0)
  activeLoans       Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  loan_applications loan_applications[]
  loans             loans[]
  properties        properties[]
}
